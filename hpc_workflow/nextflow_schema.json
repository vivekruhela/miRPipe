{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/vivekruhela/miRPipe/blob/main/hpc_workflow/nextflow_schema.json",
  "title": "miRPipe-HPC parameters",
  "description": "Parameters for the resumable miRNA/piRNA Nextflow workflow.",
  "type": "object",
  "properties": {
    "samplesheet": {"type": "string", "format": "file-path", "description": "CSV with sample, fastq, and condition columns."},
    "outdir": {"type": "string", "format": "directory-path", "default": "results"},
    "run_mirna": {"type": "boolean", "default": true},
    "run_pirna": {"type": "boolean", "default": true},
    "run_deseq2": {"type": "boolean", "default": true},
    "run_rfam": {"type": "boolean", "default": false},
    "adapter": {"type": "string", "pattern": "^[ACGTNacgtn]+$", "default": "TCGTATGCCGTCTTCTGCTTG"},
    "genome": {"type": "string", "enum": ["hg19", "hg38"], "default": "hg38"},
    "mirna_min_length": {"type": "integer", "minimum": 15, "default": 17},
    "mirna_max_length": {"type": "integer", "minimum": 17, "default": 24},
    "pirna_min_length": {"type": "integer", "minimum": 20, "default": 25},
    "pirna_max_length": {"type": "integer", "minimum": 24, "default": 31},
    "mirdeep_jar": {"type": "string"},
    "mirdeep_genome_dir": {"type": "string"},
    "mirdeep_parameter_p": {"type": "integer", "default": 20},
    "known_mature_fasta": {"type": "string"},
    "known_mirna_gff": {"type": "string"},
    "external_mature_fasta": {"type": ["string", "null"]},
    "external_mirna_gff": {"type": ["string", "null"]},
    "pirna_gff": {"type": ["string", "null"]},
    "bowtie_index": {"type": "string"},
    "design": {"type": "string", "default": "~ condition"},
    "contrast": {"type": "string", "pattern": "^[^,]+,[^,]+,[^,]+$", "default": "condition,treated,untreated"},
    "min_count": {"type": "integer", "minimum": 0, "default": 10},
    "min_samples": {"type": "integer", "minimum": 1, "default": 2},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.05},
    "container": {"type": "string", "default": "docker.io/vivekruhela/mirpipe:latest"}
  },
  "required": ["samplesheet"]
}
