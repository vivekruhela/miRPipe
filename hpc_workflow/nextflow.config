manifest {
    name            = 'miRPipe HPC'
    author          = 'Vivek Ruhela and contributors'
    homePage        = 'https://github.com/vivekruhela/miRPipe'
    description     = 'Resumable miRNA and piRNA analysis for local systems and SLURM clusters'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0-alpha.1'
}

params {
    samplesheet = null
    outdir      = 'results'

    // Analysis branches
    run_mirna  = true
    run_pirna  = true
    run_deseq2 = true
    run_rfam   = false

    // Library preprocessing
    adapter          = 'TCGTATGCCGTCTTCTGCTTG'
    trim_quality     = 20
    max_n_fraction   = 0.10
    min_avg_quality  = 20
    mirna_min_length = 17
    mirna_max_length = 24
    pirna_min_length = 25
    pirna_max_length = 31

    // miRDeep* compatibility branch
    genome              = 'hg38'
    mirdeep_jar          = '/miRPipe/Tools/MDS_command_line_v38/MDS_command_line/MD.jar'
    mirdeep_genome_dir   = '/miRPipe/Tools/MDS_command_line_v38/MDS_command_line/genome'
    mirdeep_min_score    = -20
    mirdeep_read_cutoff  = 5
    mirdeep_parameter_p  = 20
    mirdeep_precursor_len = 101

    // Local, reproducible replacement for browser-based DASHR lookup
    known_mature_fasta = '/miRPipe/Tools/MDS_command_line_v38/MDS_command_line/genome/hg38/miRBase/mature.fa'
    known_mirna_gff    = '/miRPipe/Tools/MDS_command_line_v38/MDS_command_line/genome/hg38/miRBase/knownMiR.gff3'
    external_mature_fasta = null
    external_mirna_gff    = null
    locus_tolerance       = 2
    novel_min_samples     = 2
    novel_min_total_count = 10
    novel_min_caller_score = 5.0

    // Optional Rfam screening. Use a versioned, cmpress-indexed database.
    rfam_cm = '/miRPipe/refs/Rfam.cm'

    // piRNA branch
    pirna_gff            = null
    bowtie_index         = '/miRPipe/refs/hg38/hg38'
    pirna_mismatches     = 0
    pirna_max_alignments = 1
    pirna_unique_only    = false
    pirna_stranded       = true
    bowtie_seed          = 42

    // Differential expression
    design      = '~ condition'
    contrast    = 'condition,treated,untreated'
    min_count   = 10
    min_samples = 2
    alpha       = 0.05

    // Executables inside the legacy-compatible image; all are overridable.
    bbduk_bin  = '/miRPipe/Tools/bbmap/bbduk.sh'
    bowtie_bin = '/miRPipe/Tools/bowtie-1.2.3-linux-x86_64/bowtie'
    container  = 'docker.io/vivekruhela/mirpipe:latest'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: 'qc' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: 'small' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: 'medium' {
        cpus   = 4
        memory = '8 GB'
        time   = '8h'
    }
    withLabel: 'large' {
        cpus   = 8
        memory = '16 GB'
        time   = '24h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        process.executor = 'local'
        docker.enabled   = true
        process.container = params.container
    }

    apptainer {
        process.executor    = 'local'
        apptainer.enabled   = true
        apptainer.autoMounts = true
        process.container   = params.container
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
    fields    = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,attempt,workdir,container'
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/workflow_dag.html"
    overwrite = true
}

cleanup = false
