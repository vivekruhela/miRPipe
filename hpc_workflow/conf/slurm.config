process {
    executor  = 'slurm'
    container = params.container
    maxRetries = 2
    errorStrategy = { task.exitStatus in [137, 143, 247] ? 'retry' : 'terminate' }

    // Add site-specific directives in a separate file supplied with `-c`.
    // Examples: queue = 'cpu', clusterOptions = '--account=my_account'.
}

executor {
    queueSize       = 100
    submitRateLimit = '30/1min'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${baseDir}/.apptainer"
}
